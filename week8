Here is the function — 15% VAT:
float calculateVAT(float amount) {
    return amount * 0.15;
}
*How to use it in your salary program:*
#include <stdio.h>

float calculateVAT(float amount) {
    return amount * 0.15;
}

int main() {
    float amount, vat;
    
    printf("Enter amount: ");
    scanf("%f", &amount);
    
    vat = calculateVAT(amount);
    
    printf("VAT (15%%): %.2f\n", vat);
    printf("Total with VAT: %.2f\n", amount + vat);
    
    return 0;
}
